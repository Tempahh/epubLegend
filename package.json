{
  "name": "epublegend",
  "version": "0.1.0",
  "description": "Full-stack web scraper for freewebnovel.com that generates EPUB/PDF e-books",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspace=frontend",
    "test": "npm test --workspace=frontend && npm test --workspace=backend",
    "dev": "npm run dev --workspace=frontend",
    "start": "npm run start --workspace=frontend"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.56.0",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
